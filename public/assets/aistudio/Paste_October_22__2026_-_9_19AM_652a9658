import { defineConfig, loadEnv } from 'vite';

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), '');
  const internalPort = Number(env.PORT || env.VITE_DEV_PORT || 3000);
  const publicHost = normalizeHost(
    env.VITE_HMR_HOST ||
    env.VITE_PUBLIC_HOST ||
    ''
  );
  const publicProtocol =
    env.VITE_HMR_PROTOCOL ||
    (publicHost ? 'wss' : 'ws');
  const publicClientPort = Number(
    env.VITE_HMR_CLIENT_PORT ||
    (publicProtocol === 'wss' ? 443 : internalPort)
  );

  return {
    server: {
      host: '0.0.0.0',
      port: internalPort,
      strictPort: true,

      hmr: true,

      ...(publicHost
        ? {
            ws: {
              protocol: publicProtocol,
              host: publicHost,
              clientPort: publicClientPort,
            },
          }
        : {}),
    },
  };
});

