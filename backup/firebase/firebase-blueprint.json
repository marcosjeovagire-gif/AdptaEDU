{
  "entities": {
    "AuthorizedUser": {
      "title": "Authorized User",
      "description": "User authorized to access specific roles in the school system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "emailNormalized": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "status": { "type": "string", "enum": ["authorized", "inactive", "archived"] },
        "schoolId": { "type": "string" },
        "allowedClasses": { "type": "array", "items": { "type": "string" } },
        "allowedDisciplines": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "roles"]
    },
    "Estudante": {
      "title": "Estudante",
      "description": "Student record with pedagogical and inclusion details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "matricula": { "type": "string" },
        "turma": { "type": "string" },
        "anoSerie": { "type": "string" },
        "turno": { "type": "string" },
        "situacao": { "type": "string", "enum": ["ativo", "arquivado", "transferido"] },
        "laudo": { "type": "string" },
        "schoolId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome", "turma", "schoolId"]
    },
    "PeiDocumento": {
      "title": "PEI Document",
      "description": "Individualized Education Plan (Plano de Ensino Individualizado).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string", "enum": ["rascunho", "homologado", "em_revisao"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId"]
    },
    "AtividadeAdaptada": {
      "title": "Atividade Adaptada",
      "description": "Adapted pedagogical activity generated for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "estudanteId": { "type": "string" },
        "estudanteNome": { "type": "string" },
        "turma": { "type": "string" },
        "disciplina": { "type": "string" },
        "conteudo": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "estudanteId"]
    },
    "RegistroAcompanhamentoApoio": {
      "title": "Registro de Apoio",
      "description": "Daily support log for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "nomeEstudante": { "type": "string" },
        "data": { "type": "string", "format": "date" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "data"]
    },
    "EscolaConfig": {
      "title": "Escola Config",
      "description": "Configuration and branding for the school.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "municipio": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/authorizedUsers/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Authorized system users."
    },
    "/students/{studentId}": {
      "schema": "Estudante",
      "description": "Student records."
    },
    "/peis/{peiId}": {
      "schema": "PeiDocumento",
      "description": "PEI documents."
    },
    "/activities/{activityId}": {
      "schema": "AtividadeAdaptada",
      "description": "Generated activities."
    },
    "/supportRecords/{recordId}": {
      "schema": "RegistroAcompanhamentoApoio",
      "description": "Support logs."
    },
    "/schools/{schoolId}": {
      "schema": "EscolaConfig",
      "description": "School settings."
    }
  }
}
