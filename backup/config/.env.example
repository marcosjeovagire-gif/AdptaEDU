# GEMINI_API_KEY: Chave secreta da API do Google Gemini (utilizada apenas no servidor / server-side).
# Configurada via painel de Secrets do Google AI Studio ou variáveis de ambiente do Cloud Run.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Modelo padrão da API do Gemini para tarefas pedagógicas e estruturadas.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: URL onde o applet está publicado (Cloud Run / Google AI Studio).
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: ID do projeto Google Cloud / Firebase.
FIREBASE_PROJECT_ID="gen-lang-client-0965320684"

# VITE_DEMO_MODE: Define se o sistema opera em modo de demonstração local ou integrado à nuvem.
VITE_DEMO_MODE="false"

# VITE_ALLOWED_DOMAINS: Domínios de e-mail institucionais autorizados para acesso.
VITE_ALLOWED_DOMAINS="@educa.go.gov.br,@admin.educa.go.gov.br"
