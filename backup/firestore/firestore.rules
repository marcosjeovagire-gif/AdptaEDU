rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Master Admins
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'marcosjeovagire@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // RBAC Lookup
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data;
    }

    function hasInternalRole(role) {
      return hasUserDoc() && role in getUserData().roles;
    }

    function isInternalCoordinator() { 
      return hasInternalRole('coordinator') || hasInternalRole('coordenador') || hasInternalRole('GESTOR') || hasInternalRole('superadmin'); 
    }
    
    function isInternalTeacher() { 
      return isInternalCoordinator() || hasInternalRole('teacher') || hasInternalRole('professor') || hasInternalRole('PROFESSOR'); 
    }
    
    function isInternalSupport() { 
      return isInternalCoordinator() || hasInternalRole('support') || hasInternalRole('apoio') || hasInternalRole('PROFISSIONAL_DE_APOIO'); 
    }

    // Public Helpers
    function isCoordinator() { return isSuperAdmin() || isInternalCoordinator(); }
    function isTeacher() { return isSuperAdmin() || isInternalTeacher(); }
    function isSupport() { return isSuperAdmin() || isInternalSupport(); }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATORS
    // -------------------------------------------------------------------------

    function isValidAuthorizedUser(data) {
      return data.keys().hasAll(['id', 'email', 'roles']) &&
             data.keys().hasOnly(['id', 'uid', 'name', 'nome', 'email', 'emailNormalized', 'roles', 'active', 'status', 'schoolId', 'allowedClasses', 'allowedDisciplines', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.roles is list && data.roles.size() <= 10;
    }

    function isValidEstudante(data) {
      return data.keys().hasAll(['id', 'nome', 'turma', 'schoolId']) &&
             data.keys().hasOnly(['id', 'nome', 'matricula', 'turma', 'anoSerie', 'turno', 'situacao', 'laudo', 'schoolId', 'updatedAt', 'fotoUrl', 'necessidadesEspeciais', 'professorId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.nome is string && data.nome.size() <= 200 &&
             data.turma is string && data.turma.size() <= 50 &&
             data.schoolId is string && data.schoolId.size() <= 128;
    }

    function isValidPei(data) {
      return data.keys().hasAll(['id', 'studentId', 'schoolId']) &&
             data.keys().hasOnly(['id', 'studentId', 'studentName', 'diagnosis', 'status', 'updatedAt', 'schoolId', 'historicoAlteracoes', 'periodo']) &&
             data.id is string && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['id', 'estudanteId', 'schoolId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.estudanteId is string && data.estudanteId.size() <= 128;
    }

    function isValidSupportRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'data', 'schoolId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128;
    }

    // -------------------------------------------------------------------------
    // COLLECTION MATCHES
    // -------------------------------------------------------------------------

    // 1. Authorized Users
    match /authorizedUsers/{userId} {
      allow read: if isSignedIn();
      allow create: if (isCoordinator() || (request.auth.uid == userId)) && isValidId(userId) && isValidAuthorizedUser(incoming());
      allow update: if (isCoordinator() || (request.auth.uid == userId)) && 
                     isValidAuthorizedUser(incoming()) &&
                     (isCoordinator() || incoming().roles == existing().roles);
      allow delete: if isSuperAdmin();
    }

    // 2. Students
    match /students/{studentId} {
      allow list: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow get: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow create: if isTeacher() && isValidId(studentId) && isValidEstudante(incoming()) && (isSuperAdmin() || incoming().schoolId == getUserData().schoolId);
      allow update: if isTeacher() && isValidEstudante(incoming()) && (isSuperAdmin() || (incoming().schoolId == getUserData().schoolId && existing().schoolId == getUserData().schoolId));
      allow delete: if isCoordinator() && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
    }

    // 3. PEI Documents
    match /peis/{peiId} {
      allow list: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow get: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow create: if isTeacher() && isValidId(peiId) && isValidPei(incoming()) && (isSuperAdmin() || get(/databases/$(database)/documents/students/$(incoming().studentId)).data.schoolId == getUserData().schoolId);
      allow update: if isTeacher() && isValidPei(incoming()) && (isSuperAdmin() || (existing().schoolId == getUserData().schoolId && (existing().status != 'homologado' || isInternalCoordinator())));
      allow delete: if isCoordinator() && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
    }

    // 4. Activities
    match /activities/{activityId} {
      allow list: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow get: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow create: if isTeacher() && isValidId(activityId) && isValidActivity(incoming()) && (isSuperAdmin() || get(/databases/$(database)/documents/students/$(incoming().estudanteId)).data.schoolId == getUserData().schoolId);
      allow update: if isTeacher() && isValidActivity(incoming()) && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
      allow delete: if isCoordinator() && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
    }

    // 5. Support Records
    match /supportRecords/{recordId} {
      allow list: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow get: if isSuperAdmin() || (isInternalTeacher() && resource.data.schoolId == getUserData().schoolId) || (isInternalSupport() && resource.data.schoolId == getUserData().schoolId);
      allow create: if isSupport() && isValidId(recordId) && isValidSupportRecord(incoming()) && (isSuperAdmin() || get(/databases/$(database)/documents/students/$(incoming().studentId)).data.schoolId == getUserData().schoolId);
      allow update: if isSupport() && isValidSupportRecord(incoming()) && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
      allow delete: if isCoordinator() && (isSuperAdmin() || existing().schoolId == getUserData().schoolId);
    }

    // 6. Schools
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() && isValidId(schoolId);
      allow update: if isCoordinator() && (isSuperAdmin() || schoolId == getUserData().schoolId);
      allow delete: if isSuperAdmin();
    }

    match /pedagogicalProfiles/{profileId} {
      allow read, write: if isTeacher();
    }

    match /curriculumMatrices/{matrixId} {
      allow read: if isSignedIn();
      allow write: if isCoordinator();
    }

    match /auditLogs/{logId} {
      allow read: if isCoordinator();
      allow create: if isSignedIn();
    }
  }
}
